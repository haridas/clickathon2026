# ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=hackathon
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true

# Hourly Prophet detection
MIN_HISTORY_HOURS=504
MIN_HOURLY_REQUESTS=250
PROPHET_INTERVAL_WIDTH=0.99

# HyperDX OpenTelemetry ingestion. For the Docker service on the HyperDX Linux
# host, use http://127.0.0.1:4318. Keep the API key in this uncommitted file.
HYPERDX_API_KEY=
OTEL_SERVICE_NAME=ad-anomaly-detector
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Leave blank to derive authorization from HYPERDX_API_KEY. Override only when
# your collector uses another authentication header.
OTEL_EXPORTER_OTLP_HEADERS=
