# ClickHouse Cloud (service on GCP) — from the console's Connect dialog
CLICKHOUSE_HOST=xxxxx.us-central1.gcp.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# LLM (provider swap = change these two model strings)
ANTHROPIC_API_KEY=
RCA_MODEL_STRONG=anthropic:claude-sonnet-5
RCA_MODEL_FAST=anthropic:claude-haiku-4-5

# Langfuse (cloud.langfuse.com project keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
